# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Settings are loaded by app/core/config.py.

# ── Supabase Postgres ──────────────────────────────────────────────────────
# Find these in Supabase Dashboard → Project Settings → Database → Connection string.
# DATABASE_URL: the app's runtime connection. Use the *transaction pooler* (port 6543).
# DIRECT_URL:   used by Alembic for migrations. Use the *direct* connection (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Supabase Auth ──────────────────────────────────────────────────────────
# SUPABASE_URL: Project Settings → API → Project URL.
# SUPABASE_ANON_KEY: the publishable key (Project Settings → API → Project API keys).
# SUPABASE_JWT_SECRET: legacy HS256 secret, optional (asymmetric JWKS is used instead).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ── Cloudinary ─────────────────────────────────────────────────────────────
# Find these in Cloudinary Dashboard → Product Environment Credentials.
# Either set CLOUDINARY_URL alone, OR the three CLOUDINARY_* fields below.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=# Local secrets — DO NOT COMMIT. This file is git-ignored (see .gitignore).
